{
  "name": "agent-switch",
  "version": "0.1.1",
  "description": "A pi extension that switches the main agent of a running conversation onto another agent's system prompt.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianhoehne/agent-switch.git"
  },
  "homepage": "https://github.com/adrianhoehne/agent-switch#readme",
  "bugs": {
    "url": "https://github.com/adrianhoehne/agent-switch/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
